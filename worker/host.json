{
  "version": "2.0",
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.0.0, 5.0.0)"
  },
  "extensions": {
    "queues": {
      "batchSize": 1,
      "newBatchThreshold": 0,
      "maxDequeueCount": 5,
      "visibilityTimeout": "00:02:00",
      "messageEncoding": "none"
    }
  },
  "logging": {
    "applicationInsights": { "samplingSettings": { "isEnabled": true } }
  }
}
